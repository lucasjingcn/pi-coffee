# Copy this file to `.env` (which is git-ignored) or export the values before
# `docker compose up`. pi reads the provider key from the environment, so no
# `pi /login` step is needed.

# Provider and model used by workers.
PI_COFFEE_PROVIDER=deepseek
PI_COFFEE_MODEL=deepseek-flash
PI_COFFEE_THINKING=xhigh

# Provider API key. The variable name depends on the provider:
#   deepseek -> DEEPSEEK_API_KEY, openai -> OPENAI_API_KEY,
#   anthropic -> ANTHROPIC_API_KEY, gemini -> GEMINI_API_KEY, ...
DEEPSEEK_API_KEY=

# Host port published by `docker compose` (the container always listens on 8787).
# Setting PI_COFFEE_PORT alone does not move the published port.
PI_COFFEE_HOST_PORT=8787

# Optional shared secret for /mcp and /internal/*. Set it if you expose the daemon
# beyond localhost.
PI_COFFEE_TOKEN=
